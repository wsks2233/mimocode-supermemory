# Supermemory
# Get a key at https://supermemory.ai (or use self-host below)
SUPERMEMORY_API_KEY=

# Optional: self-hosted Supermemory (npx supermemory local → http://localhost:6767)
# SUPERMEMORY_API_URL=http://localhost:6767
# SUPERMEMORY_BASE_URL=http://localhost:6767

# Debug: set to 1 to append [recall-decision] hints
# SUPERMEMORY_DEBUG=1
