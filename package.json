{
  "name": "mimocode-supermemory",
  "version": "0.2.0",
  "description": "Supermemory plugin for MiMoCode — OpenCode-style plugin[] install UX.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "mimocode-supermemory": "./bin/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "install.ps1",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mimocode",
    "supermemory",
    "plugin",
    "opencode",
    "installer"
  ],
  "peerDependencies": {
    "@mimo-ai/plugin": ">=0.1.0"
  },
  "scripts": {
    "verify-syntax": "node --check dist/index.js && node --check bin/cli.js",
    "install:local": "node bin/cli.js install",
    "status": "node bin/cli.js status"
  }
}
